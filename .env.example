# ──────────────────────────────────────────────────────────────────────────
# Lab 7 — Embedding & Vector Store · biến môi trường (tất cả TÙY CHỌN)
# Cách dùng: copy file này -> .env, rồi bỏ dấu "#" ở dòng bạn cần.
# Mọi biến đều có giá trị mặc định trong code nên .env trống vẫn chạy được.
# ──────────────────────────────────────────────────────────────────────────

# ── Chọn backend nhúng (main.py demo + benchmark) ─────────────────────────
#   mock   = giả lập (hash), nhanh, cho unit test — KHÔNG phản ánh ngữ nghĩa
#   local  = sentence-transformers đa ngôn ngữ (MiniLM), nhẹ
#   bgem3  = BGE-M3 local (BAAI/bge-m3), đa ngôn ngữ mạnh hơn — tải ~2.2GB lần đầu
#   openai = OpenAI Embeddings API (cần OPENAI_API_KEY)
# EMBEDDING_PROVIDER=mock
# EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=bgem3
# EMBEDDING_PROVIDER=openai
# LOCAL_EMBEDDING_MODEL=BAAI/bge-m3

# ── Ghi đè tên model cho từng provider (mặc định như dưới) ─────────────────
# LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# BGE_M3_MODEL=BAAI/bge-m3
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── OpenAI (chỉ khi EMBEDDING_PROVIDER=openai) ────────────────────────────
# OPENAI_API_KEY=sk-...

# ── Package solution để chấm (tests + benchmark). Mặc định: src ───────────
# Đặt bằng package cá nhân để chạy CODE CỦA BẠN thay vì template src:
# LAB_SOLUTION_PACKAGE=src.K4_2A202601078_VuHuuAn

# ── Thư mục dữ liệu cho demo main.py (mặc định: data/k4_ecommerce) ────────
# LAB_DATA_DIR=data/k4_asos_products

# ── Cache model tải về (để local/bgem3 không tải lại mỗi lần) ─────────────
# HF_HOME=./.hf-cache
# SENTENCE_TRANSFORMERS_HOME=./.sentence-transformers

# ── Bớt log ồn khi tải/encode model (tùy chọn) ────────────────────────────
# HF_HUB_DISABLE_PROGRESS_BARS=1
# HF_HUB_DISABLE_SYMLINKS_WARNING=1
# TOKENIZERS_PARALLELISM=false

# ── ChromaDB persistence (bonus, nếu bật ChromaDB backend) ────────────────
# CHROMA_PERSIST_DIR=./chroma_data
