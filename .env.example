# Gói mã nguồn cá nhân mà bộ test sẽ chấm (mỗi thành viên đổi thành gói của mình).
# Không đặt -> pytest mặc định chấm gói "src".
# LAB_SOLUTION_PACKAGE=src.K4_2A202601308_LuongMinhQuan

# Embedding provider selection for manual experiments
# EMBEDDING_PROVIDER=mock
# EMBEDDING_PROVIDER=local
# EMBEDDING_PROVIDER=openai

# Optional: set cache directories for the local multilingual embedder
# HF_HOME=./.hf-cache
# SENTENCE_TRANSFORMERS_HOME=./.sentence-transformers

# Optional: OpenAI embedding configuration
# OPENAI_API_KEY=your-key-here
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: for ChromaDB persistence (bonus task)
# CHROMA_PERSIST_DIR=./chroma_data
